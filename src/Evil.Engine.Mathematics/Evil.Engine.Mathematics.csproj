<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Evil.Engine.Mathematics</PackageId>
    <Description>Evil Engine 2D math: rectangles, angles, transforms, the grouped transform stack and polygons. No dependencies, so game rules and tests can use it without a window.</Description>
    <PackageTags>evil;engine;2d;math</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Evil.Engine" />
    <InternalsVisibleTo Include="Evil.Engine.Tests" />
  </ItemGroup>

</Project>
