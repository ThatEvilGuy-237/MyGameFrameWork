<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Evil.Engine</PackageId>
    <Description>Evil Engine: a small 2D game engine on OpenGL 3.3. Game builder, scenes, a batched canvas with grouped transforms, textures and sprite regions, keyboard and mouse, frame capture.</Description>
    <PackageTags>evil;engine;2d;opengl;game</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evil.Engine.Mathematics\Evil.Engine.Mathematics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.Graphics" />
    <PackageReference Include="OpenTK.Windowing.Desktop" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Graphics\Shaders\*.glsl" LogicalName="Evil.Engine.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Evil.Engine.Tests" />
  </ItemGroup>

</Project>
