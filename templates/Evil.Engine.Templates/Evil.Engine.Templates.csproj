<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Evil.Engine.Templates</PackageId>
    <Description>Evil Engine: `dotnet new evil-game` makes a Godot 4.7.2 game that talks only to Evil Engine, with the code style checked by the build.</Description>
    <PackageTags>evil;engine;godot;template</PackageTags>
    <IsPackable>true</IsPackable>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="evil-game\**\*" Exclude="evil-game\**\bin\**;evil-game\**\obj\**;evil-game\**\.godot\**" />
  </ItemGroup>

</Project>
